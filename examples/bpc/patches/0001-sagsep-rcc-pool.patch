+
+        bool startsWithUpper(const std::string &line, const std::string &prefix) {
+            return line.size() >= prefix.size() && upperAscii(line.substr(0, prefix.size())) == prefix;
+        }
+
+        std::string vrpPathStem(const std::string &path) {
+            const std::size_t slash = path.find_last_of("/\\");
+            const std::string base = slash == std::string::npos ? path : path.substr(slash + 1);
+            const std::size_t dot = base.find_last_of('.');
+            return (dot == std::string::npos || dot == 0) ? base : base.substr(0, dot);
+        }
+
+        void checkInstanceName(const std::string &name, const std::string &origin);
+
+        std::string instanceNameFromVrpFile(const std::string &path) {
+            std::ifstream in(path);
+            if (!in) throw std::runtime_error("SAGSEP_INSTANCE_FILE cannot be opened: " + path);
+
+            std::string name = vrpPathStem(path);
+            enum { HEADERS, COORDS, DEMANDS, DEPOT } section = HEADERS;
+            std::string raw;
+            while (std::getline(in, raw)) {
+                if (!raw.empty() && raw.back() == '\r') raw.pop_back();
+                const std::string line = vrpStrip(raw);
+                if (line.empty()) continue;
+
+                if (startsWithUpper(line, "NODE_COORD_SECTION")) { section = COORDS; continue; }
+                if (startsWithUpper(line, "DEMAND_SECTION")) { section = DEMANDS; continue; }
+                if (startsWithUpper(line, "DEPOT_SECTION")) { section = DEPOT; continue; }
+                if (startsWithUpper(line, "EOF")) break;
+
+                if (section == DEPOT && line.size() >= 2 && line[0] == '-' && line[1] == '1') {
+                    section = HEADERS;
+                    continue;
+                }
+                if (section != HEADERS) continue;
+
+                const std::size_t colon = line.find(':');
+                if (colon == std::string::npos) continue;
+                if (upperAscii(vrpStrip(line.substr(0, colon))) != "NAME") continue;
+                name = vrpStrip(line.substr(colon + 1));
+            }
+
+            checkInstanceName(name, "the NAME header of " + path);
+            return name;
+        }
+
+        void checkInstanceName(const std::string &name, const std::string &origin) {
+            if (name.empty()) {
+                throw std::runtime_error("empty SAG-Sep instance name from " + origin);
+            }
+            if (name.size() >= SAGSEP_NAME_MAX) {
+                throw std::runtime_error("SAG-Sep instance name is longer than 127 bytes: " + name);
+            }
+            for (std::size_t i = 0; i < name.size(); ++i) {
+                const unsigned char ch = static_cast<unsigned char>(name[i]);
+                if (ch < 0x20 || ch >= 0x7f) {
+                    throw std::runtime_error(
+                        origin + " contains a non-printable byte at position "
+                        + std::to_string(i) + "; SAG-Sep hashes the name byte by byte and refuses it");
+                }
+            }
+        }
+
+        std::string resolveInstanceName() {
+            if (const char *explicit_name = std::getenv("SAGSEP_INSTANCE_NAME")) {
+                if (*explicit_name != '\0') {
+                    const std::string name(explicit_name);
+                    checkInstanceName(name, "SAGSEP_INSTANCE_NAME");
+                    return name;
+                }
+            }
+            return instanceNameFromVrpFile(requiredEnv("SAGSEP_INSTANCE_FILE"));
+        }
+
+        /* ---------------------------------------------------------------
+         * The per-instance handle
+         * --------------------------------------------------------------- */
+
+        struct SagsepDeleter {
+            void operator()(sag_separator *value) const { sag_separator_destroy(value); }
+        };
+
+        using SagsepHandle = std::unique_ptr<sag_separator, SagsepDeleter>;
+
+        std::size_t arenaBytes() {
+            const char *mib = std::getenv("SAGSEP_ARENA_MIB");
+            if (mib == nullptr || *mib == '\0') return 0;
+            const std::string text(mib);
+            if (text.find_first_not_of("0123456789") != std::string::npos) {
+                throw std::runtime_error("SAGSEP_ARENA_MIB must be decimal digits only, got \""
+                                         + text + "\"");
+            }
+            unsigned long long value = 0;
+            std::size_t consumed = 0;
+            try {
+                value = std::stoull(text, &consumed);
+            } catch (const std::exception &) {
+                throw std::runtime_error("SAGSEP_ARENA_MIB is not a number: \"" + text + "\"");
+            }
+            if (consumed != text.size()) {
+                throw std::runtime_error("SAGSEP_ARENA_MIB has trailing characters: \"" + text + "\"");
+            }
+            if (value == 0 || value > (1ULL << 20)) {
+                throw std::runtime_error("SAGSEP_ARENA_MIB is out of range: " + text);
+            }
+            return static_cast<std::size_t>(value) << 20;
+        }
+
+        /* ---------------------------------------------------------------
+         * The per-instance handle: identity and creation
+         * --------------------------------------------------------------- */
+        struct SagsepIdentity {
+            int dim{-1};
+            std::int64_t capacity{-1};
+            std::vector<std::int64_t> demand{};
+            std::string instance_name{};
+            std::string model{};
+            std::string preset{};
+            std::string provider{};
+            int cross_depot{-1};
+            std::size_t arena_bytes{0};
+
+            bool operator==(const SagsepIdentity &other) const {
+                return dim == other.dim && capacity == other.capacity && demand == other.demand
+                       && instance_name == other.instance_name && model == other.model
+                       && preset == other.preset && provider == other.provider
+                       && cross_depot == other.cross_depot && arena_bytes == other.arena_bytes;
+            }
+        };
+
+        double last_init_seconds = 0.0;
+
+        sag_separator &sagsepSeparator(const int dim,
+                                       const std::int64_t capacity,
+                                       const std::vector<std::int64_t> &demand) {
+            static SagsepHandle handle;
+            static SagsepIdentity identity;
+
+            SagsepIdentity wanted;
+            wanted.dim = dim;
+            wanted.capacity = capacity;
+            wanted.demand = demand;
+            wanted.instance_name = resolveInstanceName();
+            wanted.model = requiredEnv("SAGSEP_MODEL");
+            wanted.preset = requiredEnv("SAGSEP_PRESET");
+            wanted.provider = requiredEnv("SAGSEP_PROVIDER");
+            wanted.cross_depot = static_cast<int>(parseCrossDepot());
+            wanted.arena_bytes = arenaBytes();
+
+            if (!handle) {
+                sag_separator_options options{};
+                options.model_path = wanted.model.c_str();
+                options.provider = wanted.provider.c_str();
+                options.instance_name = wanted.instance_name.c_str();
+                options.preset = wanted.preset.c_str();
+                options.cross_depot = static_cast<sag_separator_cross_depot>(wanted.cross_depot);
+                options.n_nodes = dim;
+                options.capacity = capacity;
+                options.demand = wanted.demand.data();
+                options.iteration_arena_bytes = wanted.arena_bytes;
+
+                const auto started = std::chrono::steady_clock::now();
+                sag_separator *created = sag_separator_create(&options);
+                last_init_seconds = std::chrono::duration<double>(
+                    std::chrono::steady_clock::now() - started).count();
+                if (created == nullptr) {
+                    throw std::runtime_error(
+                        "sag_separator_create returned null for instance \"" + wanted.instance_name
+                        + "\" with model \"" + wanted.model + "\"");
+                }
+                handle.reset(created);
+                identity = wanted;
+                std::cout << "[SAGSEP_INIT] " << sag_separator_description(handle.get())
+                        << " t_init=" << last_init_seconds << std::endl;
+            } else if (!(identity == wanted)) {
+                throw std::runtime_error(
+                    "one RouteOpt process must solve exactly one instance with one separator "
+                    "configuration when SAGSEP_RCC_POOL=sagseptts; the instance or a SAGSEP_* "
+                    "option changed after the separator was created");
+            }
+            return *handle;
+        }
+
+        /* ---------------------------------------------------------------
+         * The blocked set
+         * --------------------------------------------------------------- */
+        void installBlockedSet(sag_separator &separator,
+                               const int dim,
+                               const std::vector<Rcc> &existing_rccs) {
+            std::vector<std::int64_t> indptr;
+            std::vector<std::int32_t> customers;
+            indptr.reserve(existing_rccs.size() + 1);
+            indptr.emplace_back(0);
+
+            std::vector<int> subset;
+            for (const auto &rcc: existing_rccs) {
+                subset = rcc.info_rcc_customer;
+                std::sort(subset.begin(), subset.end());
+                subset.erase(std::unique(subset.begin(), subset.end()), subset.end());
+                if (subset.empty()) continue;
+                if (subset.front() <= 0 || subset.back() >= dim) {
+                    throw std::runtime_error(
+                        "an RCC in the node's pool holds a customer outside 1..dim-1");
+                }
+                for (const int customer: subset) {
+                    customers.emplace_back(static_cast<std::int32_t>(customer));
+                }
+                indptr.emplace_back(static_cast<std::int64_t>(customers.size()));
+            }
+
+            const auto rows = static_cast<std::int64_t>(indptr.size()) - 1;
+            sag_separator_set_blocked(&separator, rows, indptr.data(),
+                                      customers.empty() ? nullptr : customers.data());
+        }
+
+        /* ---------------------------------------------------------------
+         * The two-index support of the column solution
+         * --------------------------------------------------------------- */
+        struct UndirectedSupport {
+            std::vector<std::int64_t> u;
+            std::vector<std::int64_t> v;
+            std::vector<double> x;
+        };
+
+        UndirectedSupport undirectedSupport(const int dim,
+                                            const std::vector<double> &sol_x,
+                                            const std::vector<SequenceInfo> &sols) {
+            std::vector<int> edge_tail, edge_head;
+            std::vector<double> edge_value;
+            getMap(sol_x, sols, dim, edge_tail, edge_head, edge_value);
+            if (edge_tail.size() != edge_head.size() || edge_tail.size() != edge_value.size()) {
+                throw std::runtime_error("getMap returned ragged edge arrays");
+            }
+
+            std::vector<std::pair<std::pair<int, int>, double> > entries;
+            entries.reserve(edge_tail.size());
+            for (std::size_t e = 1; e < edge_tail.size(); ++e) {
+                const int tail = edge_tail[e] == dim ? 0 : edge_tail[e];
+                const int head = edge_head[e];
+                const double value = edge_value[e];
+                if (!std::isfinite(value)) {
+                    throw std::runtime_error("getMap produced a non-finite support value");
+                }
+                if (value < -SUPPORT_TOLERANCE) {
+                    throw std::runtime_error("getMap produced a materially negative support value: "
+                                             + std::to_string(value));
+                }
+                if (!(value > SUPPORT_TOLERANCE)) continue;
+                if (tail < 0 || head <= tail || head >= dim) {
+                    throw std::runtime_error("getMap produced an out-of-range edge ("
+                                             + std::to_string(tail) + ", " + std::to_string(head) + ")");
+                }
+                entries.emplace_back(std::make_pair(tail, head), value);
+            }
+            std::sort(entries.begin(), entries.end(),
+                      [](const auto &lhs, const auto &rhs) { return lhs.first < rhs.first; });
+
+            UndirectedSupport support;
+            support.u.reserve(entries.size());
+            support.v.reserve(entries.size());
+            support.x.reserve(entries.size());
+            for (const auto &entry: entries) {
+                if (!support.u.empty()
+                    && std::make_pair(static_cast<int>(support.u.back()),
+                                      static_cast<int>(support.v.back())) == entry.first) {
+                    throw std::runtime_error("getMap produced a duplicate undirected edge");
+                }
+                support.u.emplace_back(entry.first.first);
+                support.v.emplace_back(entry.first.second);
+                support.x.emplace_back(entry.second);
+            }
+            return support;
+        }
+
+        void checkReturnedCuts(const sag_separator_cuts &cuts, const int dim) {
+            if (cuts.rows < 0) {
+                throw std::runtime_error("SAG-Sep returned a negative row count");
+            }
+            if (cuts.rows == 0) return;
+            if (cuts.indptr == nullptr || cuts.customers == nullptr
+                || cuts.rhs == nullptr || cuts.violation == nullptr) {
+                throw std::runtime_error("SAG-Sep returned null arrays for a non-empty cut batch");
+            }
+            if (cuts.indptr[0] != 0) {
+                throw std::runtime_error("SAG-Sep returned an indptr that does not start at 0");
+            }
+            for (std::int64_t row = 0; row < cuts.rows; ++row) {
+                const std::int64_t begin = cuts.indptr[row];
+                const std::int64_t end = cuts.indptr[row + 1];
+                if (end < begin) {
+                    throw std::runtime_error("SAG-Sep returned a non-monotone indptr at row "
+                                             + std::to_string(row));
+                }
+                if (end == begin) {
+                    throw std::runtime_error("SAG-Sep returned an empty customer set at row "
+                                             + std::to_string(row));
+                }
+                for (std::int64_t k = begin; k < end; ++k) {
+                    const std::int32_t customer = cuts.customers[k];
+                    if (customer <= 0 || customer >= dim) {
+                        throw std::runtime_error(
+                            "SAG-Sep returned a customer index outside 1..dim-1 at row "
+                            + std::to_string(row));
+                    }
+                    if (k > begin && customer <= cuts.customers[k - 1]) {
+                        throw std::runtime_error(
+                            "SAG-Sep returned a customer set that is not strictly increasing at row "
+                            + std::to_string(row));
+                    }
+                }
+                if (!std::isfinite(cuts.rhs[row]) || !std::isfinite(cuts.violation[row])) {
+                    throw std::runtime_error("SAG-Sep returned a non-finite rhs or violation at row "
+                                             + std::to_string(row));
+                }
+            }
+        }
+
+        void generateSagsepRCCs(const int dim,
+                                const std::int64_t capacity,
+                                const std::vector<std::int64_t> &demand,
+                                const bool if_keep_rcc,
+                                const bool if_strengthen_rcc,
+                                const std::vector<double> &sol_x,
+                                const std::vector<SequenceInfo> &sols,
+                                const std::vector<Rcc> &existing_rccs,
+                                std::vector<Rcc> &new_rccs) {
+            new_rccs.clear();
+
+            last_init_seconds = 0.0;
+            sag_separator &separator = sagsepSeparator(dim, capacity, demand);
+            const double init_seconds = last_init_seconds;
+            installBlockedSet(separator, dim, existing_rccs);
+
+            const UndirectedSupport support = undirectedSupport(dim, sol_x, sols);
+
+            static long long round_counter = 0;
+            ++round_counter;
+
+            if (support.x.empty()) {
+                std::cout << "[RCC_ROUND] pool=sagseptts"
+                        << " round=" << round_counter
+                        << " call_site=" << callSiteName(if_keep_rcc)
+                        << " form=" << (if_strengthen_rcc ? "strengthened" : "plain")
+                        << " node_pool=" << existing_rccs.size()
+                        << " empty_support=1"
+                        << " iteration=0 replicas=0 support=0 raw=0 unique=0"
+                        << " blocked_keys=0 blocked=0 proposed=0 admitted=0 duplicate=0"
+                        << " returned=0 max_violation=0"
+                        << " t_init=" << init_seconds
+                        << " t_forward=0 t_total=0"
+                        << std::endl;
+                return;
+            }
+
+            sag_separator_cuts cuts{};
+            sag_separator_stats stats{};
+            const std::int64_t returned_rows =
+                    sag_separator_separate(&separator,
+                                           static_cast<std::int64_t>(support.x.size()),
+                                           support.u.data(), support.v.data(), support.x.data(),
+                                           &cuts, &stats);
+            if (returned_rows != cuts.rows) {
+                throw std::runtime_error("SAG-Sep's return value and cuts.rows disagree");
+            }
+            checkReturnedCuts(cuts, dim);
+
+            std::vector<std::int64_t> committed_rows;
+            committed_rows.reserve(static_cast<std::size_t>(cuts.rows));
+            new_rccs.reserve(static_cast<std::size_t>(cuts.rows));
+
+            std::int64_t admitted = 0, duplicates = 0;
+            double max_violation = 0.0;
+
+            for (std::int64_t row = 0; row < cuts.rows; ++row) {
+                if (!(cuts.violation[row] > stats.min_violation)) continue;
+                ++admitted;
+
+                const std::int64_t begin = cuts.indptr[row];
+                const std::int64_t end = cuts.indptr[row + 1];
+                const std::vector<int> customers(cuts.customers + begin, cuts.customers + end);
+
+                std::int64_t load = 0;
+                for (const int customer: customers) {
+                    load = addLoad(load, demand[static_cast<std::size_t>(customer)]);
+                }
+                const std::int64_t expected_k = ceilDivPositive(load, capacity);
+                const std::int64_t reported_k = checkedIntegral(cuts.rhs[row], "SAG-Sep rhs");
+                if (expected_k != reported_k) {
+                    throw std::runtime_error("SAG-Sep rhs is not ceil(d(S)/Q): got "
+                                             + std::to_string(reported_k) + ", expected "
+                                             + std::to_string(expected_k));
+                }
+
+                Rcc rcc = toRouteOptCut(customers, static_cast<double>(expected_k), dim,
+                                        if_strengthen_rcc, if_keep_rcc);
+
+                const bool already_in_model =
+                        std::find(existing_rccs.begin(), existing_rccs.end(), rcc) != existing_rccs.end()
+                        || std::find(new_rccs.begin(), new_rccs.end(), rcc) != new_rccs.end();
+
+                committed_rows.emplace_back(row);
+
+                if (already_in_model) {
+                    ++duplicates;
+                    continue;
+                }
+                max_violation = std::max(max_violation, cuts.violation[row]);
+                new_rccs.emplace_back(std::move(rcc));
+            }
+
+            sag_separator_commit(&separator,
+                                 committed_rows.empty() ? nullptr : committed_rows.data(),
+                                 static_cast<std::int64_t>(committed_rows.size()));
+
+            std::cout << "[RCC_ROUND] pool=sagseptts"
+                    << " round=" << round_counter
+                    << " call_site=" << callSiteName(if_keep_rcc)
+                    << " form=" << (if_strengthen_rcc ? "strengthened" : "plain")
+                    << " node_pool=" << existing_rccs.size()
+                    << " iteration=" << stats.iteration
+                    << " replicas=" << stats.replicas
+                    << " support=" << stats.support_edges
+                    << " raw=" << stats.raw_candidates
+                    << " unique=" << stats.unique_candidates
+                    << " blocked_keys=" << stats.blocked_keys
+                    << " blocked=" << stats.blocked_candidates
+                    << " proposed=" << stats.materialized_cuts
+                    << " admitted=" << admitted
+                    << " duplicate=" << duplicates
+                    << " returned=" << new_rccs.size()
+                    << " max_violation=" << max_violation
+                    << " t_init=" << init_seconds
+                    << " t_forward=" << stats.forward_seconds
+                    << " t_total=" << stats.total_seconds
+                    << std::endl;
+        }
+    }
+
+    void RCCSeparationController::generateRCCs(int dim,
+                                               double cap,
+                                               const std::vector<double> &demand,
+                                               bool if_keep_rcc,
+                                               bool if_strengthen_rcc,
+                                               const std::vector<double> &sol_x,
+                                               const std::vector<SequenceInfo> &sols,
+                                               const std::vector<Rcc> &existing_rccs,
+                                               std::vector<Rcc> &new_rccs) {
+        new_rccs.clear();
+
+        const RccPool pool = rccPool();
+
+        const std::int64_t capacity = checkedCapacity(cap);
+        const std::vector<std::int64_t> demand_i = checkedDemand(demand, dim);
+        checkColumnSolution(dim, sol_x, sols);
+
+        std::vector<Rcc> audit_rccs;
+        const AuditReport audit = auditIntegralRoutes(dim, capacity, demand_i, if_keep_rcc,
+                                                     if_strengthen_rcc, sol_x, sols,
+                                                     existing_rccs, audit_rccs);
+        std::cout << "[RCC_AUDIT]"
+                << " call_site=" << callSiteName(if_keep_rcc)
+                << " pool=" << (pool == RccPool::CVRPSEP ? "cvrpsep" : "sagseptts")
+                << " integral=" << (audit.integral ? 1 : 0)
+                << " routes=" << audit.routes
+                << " overloaded=" << audit.overloaded
+                << " rows=" << audit.rows
+                << std::endl;
+
+        std::vector<Rcc> pool_rccs;
+        switch (pool) {
+            case RccPool::CVRPSEP:
+                generateCvrpsepRCCs(dim, cap, demand, if_keep_rcc, if_strengthen_rcc,
+                                    sol_x, sols, existing_rccs, pool_rccs);
+                break;
+            case RccPool::SAGSEP_TTS:
+                generateSagsepRCCs(dim, capacity, demand_i, if_keep_rcc, if_strengthen_rcc,
+                                   sol_x, sols, existing_rccs, pool_rccs);
+                break;
+            default:
+                throw std::runtime_error("unreachable SAGSEP_RCC_POOL value");
+        }
+
+        new_rccs = std::move(audit_rccs);
+        for (auto &rcc: pool_rccs) {
+            if (std::find(new_rccs.begin(), new_rccs.end(), rcc) != new_rccs.end()) continue;
+            new_rccs.emplace_back(std::move(rcc));
+        }
     }
 }
